<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TMG" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/tmg_primary</item>
        <item name="colorOnPrimary">@color/tmg_on_primary</item>
        <item name="colorPrimaryContainer">@color/tmg_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/tmg_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/tmg_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/tmg_on_secondary_container</item>
        <item name="android:colorBackground">@color/tmg_surface_light</item>
        <item name="colorSurface">@color/tmg_surface_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.TMG.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#8FD9B6</item>
        <item name="colorOnPrimary">#003824</item>
        <item name="colorPrimaryContainer">#1B5C43</item>
        <item name="colorOnPrimaryContainer">#B8F0D4</item>
        <item name="android:colorBackground">@color/tmg_surface_dark</item>
        <item name="colorSurface">@color/tmg_surface_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

</resources>
